# Gmail MCP Server Environment Variables
# Copy this file to .env and customize as needed

# Optional: Custom OAuth credential location
# GMAIL_OAUTH_CONFIG=/path/to/oauth-credentials.json

# Optional: Custom token storage location
# GMAIL_TOKEN_PATH=/path/to/credentials.json

# Optional: Logging level
# GMAIL_MCP_LOG_LEVEL=INFO

# Note: The server auto-discovers credentials in these locations:
# 1. ~/.gmail-mcp/oauth-credentials.json
# 2. /home/salim/Desktop/hackathon0/gcp-oauth.keys.json
# 3. Path specified in GMAIL_OAUTH_CONFIG environment variable
